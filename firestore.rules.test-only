rules_version = '2';

// QUICK FALLBACK for testing only: any logged-in user can read and write.
// Use this only to check whether the problem is the rules. It has NO protection
// (no locked phone number, no cash-in limit checks in Firebase).

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
